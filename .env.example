# GEMINI_API_KEY: Server-side API key for ParkPool AI GenAI Driver Assistant (models/gemini-4-hydrogen).
# Configured via AI Studio Secrets panel.
GEMINI_API_KEY=

# OPENROUTER_API_KEY: Optional OpenRouter AI fallback for multi-agent workflows.

# OPENROUTER_MODEL: Optional OpenRouter model slug (defaults to openrouter/auto).
OPENROUTER_MODEL=openrouter/auto

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional administrator passcode for the Admin Portal.
# If left unset in preview, the first admin can claim a passcode via the inline Admin Setup form.
ADMIN_PASSCODE=

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform browser key.
# Leave unset here and configure via AI Studio Secrets / runtime environment.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

